#!/bin/bash
set -euo pipefail

input="$(swaymsg -t get_inputs | jq -r 'map(select(has("xkb_active_layout_name")))[0].xkb_active_layout_name')"
case "$input" in
	"Estonian (no dead keys)")
		;;
	"Russian (Sweden, phonetic)")
		echo "[ru]"
		;;
	"English (US)")
		echo "[en]"
		;;
	"Czech"*)
		echo "[cz]"
		;;
	*)
		echo "[kbd?] $input"
		;;
esac
