#!/usr/bin/env bash
set -eo pipefail

MAGICKCMD="${MAGICKCMD:=-append}"

case "$#" in
	0)
		echo "ERROR: expected 1 or 2+ arguments"
		echo "USAGE: $0 <input directory> # deletes originals"
		echo "USAGE: $0 <insertable file...> # keeps originals"
		exit 1
		;;
	1)
		continue
		;;
	*)
		base="$(revcut -d. -f2- <<< "$1")"
		ext="$(revcut -d. -f1 <<< "$1")"

		out="$base-joined.$ext"
		echo "$out"

		magick "$@" "$MAGICKCMD" "$out"
		exit "$?"
		;;
esac

for ext in png webp jpg; do
if compgen -G "$1/*-1.$ext" > /dev/null; then

	for i in "$1"/*-1."$ext"; do
		base="$(revcut -d- -f2- <<< "$i")"

		if [[ -f "$base"."$ext" ]]; then
			echo "ERROR: not overwriting $base."$ext""
			continue
		fi

		magick "$base"-*."$ext" "$MAGICKCMD" "$base"."$ext"

		touch -r "$i" "$base"."$ext"
		rm "$base"-*."$ext"
	done

fi
done
